        </mxCell>
        <mxCell id="e44" value="TransactionPosted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B7791F;fontFamily=Arial;fontSize=12;fontColor=#17324D;labelBackgroundColor=#FFFFFF;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="n23" target="n25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" value="TLS · fallback por política" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B7791F;fontFamily=Arial;fontSize=12;fontColor=#17324D;labelBackgroundColor=#FFFFFF;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="n25" target="n26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;Regla de timeout&lt;/b&gt;&lt;br&gt;Timeout externo no significa rechazo. Consultar por referencia antes de reintentar.&lt;br&gt;Sin débito ciego; pendientes pasan a conciliación." style="shape=note;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF1D2;strokeColor=#B7791F;strokeWidth=2;fontColor=#162B3D;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1795" y="1095" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;Compensación&lt;/b&gt;&lt;br&gt;Solo si Core/riel confirman reverso.&lt;br&gt;Una Saga gestiona estado distribuido;&lt;br&gt;no ofrece rollback ACID global." style="shape=note;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF1D2;strokeColor=#B7791F;strokeWidth=2;fontColor=#162B3D;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1795" y="165" width="530" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;Correspondencia BIAN&lt;/b&gt;&lt;br&gt;Payment Order Initiation crea / valida la orden; Transaction Authorization evalúa permisos y controles; Payment Execution coordina el envío al Core o al riel. Son responsabilidades de referencia, no componentes de despliegue obligatorios." style="shape=note;rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF1D2;strokeColor=#B7791F;strokeWidth=2;fontColor=#162B3D;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="870" width="1160" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
