flowchart LR
  subgraph edge["Perímetro"]
    apim["API Management<br/>JWT aud/iss/scopes, quota, WAF upstream"]
    bff["BFF<br/>Cookie/session or mobile token, CSRF"]
  end
  subgraph svc["Transfer Service | bounded context"]
    api["Transfer API<br/>Schema + ownership checks"]
    idem["Idempotency Handler<br/>Unique key + request hash"]
    limits["Policy / Risk Adapter<br/>Limits, beneficiary, step-up"]
    saga["Persisted Transfer Orchestrator<br/>State machine, timeout, reconciliation"]
    coread["Core Adapter<br/>Balance/read + debit/credit contract"]
    railad["Payment Rail Adapter<br/>Signed request/callback"]
    repo["Transfer Repository<br/>ACID local transaction"]
    outbox["Transactional Outbox<br/>Same DB commit as state change"]
  end
  db[("PostgreSQL HA<br/>Transfer state + unique idempotency + Outbox")]
  core["Core ledger<br/>Authoritative posting"]
  rail["Interbank network"]
  relay["Outbox relay"]
  bus["Service Bus Topic<br/>TransactionPosted / Failed"]
  consumers["Audit + Notification consumers<br/>Dedup eventId, retry/DLQ"]
  archive["Immutable audit store<br/>RBAC + retention lock"]
  user["Web / Mobile"]
  user -->|HTTPS| apim -->|HTTPS + JWT| bff --> api
  api --> idem --> limits --> saga
  saga -->|private mTLS/OAuth2| coread --> core
  saga -->|private mTLS; callback signature| railad --> rail
  saga --> repo --> db
  repo --> outbox --> db
  db --> relay --> bus --> consumers
  consumers --> archive
  consumers -->|provider-specific TLS| bus
  note["Rules: timeout != failure; query status before retry. No blind debit replay.\nPOSTED only after authoritative confirmation; unresolved outcomes enter reconciliation."]
  saga -.-> note
