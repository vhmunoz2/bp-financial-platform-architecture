        <mxCell id="e42" value="At-least-once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B42318;fontFamily=Arial;fontSize=12;fontColor=#17324D;labelBackgroundColor=#FFFFFF;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="n22" target="n23">
